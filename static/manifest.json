{
  "manifest_version": 3,
  "name": "Paws Agent Bubble",
  "description": "Start and continue remote Paws Agent sessions from the current page.",
  "version": "0.0.2",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "host_permissions": [
    "https://47.115.228.20:8443/*",
    "https://happy-attachments-jacky.oss-cn-hangzhou.aliyuncs.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.html", "panel.js", "styles.css", "annotation-popup.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
